{
  "name": "supabase-keeper",
  "version": "0.1.0",
  "description": "Supabase Keeper CLI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "supabase-keeper": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts",
